{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "theflamechicago.com" }],
      "destination": "https://www.theflamechicago.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "theflamechicago.com" }],
      "destination": "https://www.theflamechicago.com/:path+",
      "permanent": true
    }
  ]
}
